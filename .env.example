# Where the dev server sends /v1 (the bimayantra-api / insurehub-backend server)
VITE_API_PROXY_TARGET=http://localhost:4000
# API base path the browser calls. Keep /v1 with the proxy; for a separately hosted API use its full URL,
# e.g. https://api.bimayantra.in/v1 (then the API must allow this site's origin and send cookies cross-site).
VITE_API_BASE=/v1
# Show the Figma prototype frames (/x/…, /screens) in a build. Leave unset in production; npm run dev always shows them.
# VITE_SHOW_PROTOTYPES=true

# P-56 prepaid WhatsApp wallet: hidden unless "true" (must match WHATSAPP_WALLET on the API).
# VITE_WHATSAPP_WALLET=true
